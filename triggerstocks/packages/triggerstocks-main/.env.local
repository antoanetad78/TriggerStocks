# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# NextAuth — generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=/YTnvWzfAYiZOiugWNBpLT1mV1kt+6kLiCGPhfQAFDw=
NEXTAUTH_URL=http://localhost:4200

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/
APPLE_ID=
APPLE_SECRET=

# Facebook Login — https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# MongoDB (for when the DB layer is wired up)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/triggerstocks
